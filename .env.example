# ============================================================
# SchedBot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- Anthropic (required) ---
# Powers request classification, message drafting, and slot-picking reasoning.
ANTHROPIC_API_KEY=sk-ant-...

# --- cal.com (recommended primary integration) ---
# Generate at: https://cal.com/settings/developer/api-keys
# Simple API key — no OAuth dance required.
CALCOM_API_KEY=cal_live_...

# Webhook signing secret. Set this to whatever value you configured on
# cal.com's webhook subscription. Leave blank to disable signature
# verification (only safe behind an authenticated edge).
CALCOM_WEBHOOK_SECRET=

# --- Google Calendar (optional secondary integration) ---
# OAuth 2.0 — see docs/API_KEYS.md for the full setup walkthrough.
# Path to the OAuth2 client credentials JSON downloaded from Google Cloud
# Console (APIs & Services → Credentials → "Desktop app" → Download JSON).
GOOGLE_CALENDAR_CREDENTIALS_PATH=./google_credentials.json

# Path where the OAuth2 refresh token will be cached after the first auth
# dance. Safe to leave at the default; .gitignored.
GOOGLE_CALENDAR_TOKEN_PATH=./.google_calendar_token.json

# Either provide the credentials JSON file above, OR these two values
# inline (the connector falls back to inline values if the JSON path is
# unset / unreadable).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Calendly (optional alternative) ---
# Personal access token from https://calendly.com/integrations/api_webhooks
CALENDLY_API_KEY=

# --- Acuity Scheduling (optional alternative) ---
# Basic-auth pair from https://secure.acuityscheduling.com/app.php
ACUITY_USER_ID=
ACUITY_API_KEY=

# --- SMTP / Gmail (sending confirmations + reminders) ---
# Gmail app-password docs: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# --- Twilio (optional SMS reminders + confirmations) ---
# Install with: uv sync --extra sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Inbound webhook receiver ---
# Shared secret used to HMAC-sign incoming requests from website forms /
# embedded booking widgets. Leave blank to disable signature verification
# (only safe behind an authenticated edge).
WEBHOOK_SIGNING_SECRET=

# --- App Settings ---
# Path to the config YAML the engine should load. Defaults to ./config.yaml.
CONFIG_PATH=config.yaml

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
